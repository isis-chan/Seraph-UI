                        bindListening = false
                        connection:Disconnect()
                    end
                end)
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if boundKey and input.KeyCode == boundKey then
                        setState(not state)
                    end
                end
            end)
        end

        local obj = {
            key = name,
            setState = setState,
            getState = function() return state end,
            getBind = function() return boundKey end,
            setBind = function(newKey)
                boundKey = newKey
                if bindKeyLabel then
                    bindKeyLabel.Text = newKey and shortenKeyName(newKey) or "None"
                end
            end
        }
        table.insert(window.Registry.toggles, obj)
    end)
end

--[[
    CreateSlider({
        Name = "Walk Speed",
        Min = 16, Max = 200, Default = 16,
        Callback = function(value) end
    })
]]
function Tab:CreateSlider(config)
    local window = self.Window
    self:_enqueue(function(page)
        local name = config.Name or "Slider"
        local min = config.Min or 0
        local max = config.Max or 100
        local default = config.Default or min
        local callback = config.Callback or function() end

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1, -6, 0, 50)
        container.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        container.BackgroundTransparency = 0.94
        container.Parent = page

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = container

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 0.92
        stroke.Parent = container

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.6, 0, 0, 22)
        label.Position = UDim2.new(0, 12, 0, 6)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Ubuntu
        label.Text = name
        label.TextColor3 = Color3.fromRGB(220, 220, 235)
        label.TextSize = 13 * math.min(window.CurrentScale, 1.2)
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = container

        local valBox = Instance.new("TextBox")
        valBox.Size = UDim2.new(0.3, 0, 0, 22)
        valBox.Position = UDim2.new(0.7, -12, 0, 6)
        valBox.BackgroundTransparency = 1
        valBox.Font = Enum.Font.Ubuntu
        valBox.Text = tostring(default)
        valBox.TextColor3 = Color3.fromRGB(160, 170, 200)
        valBox.TextSize = 12 * math.min(window.CurrentScale, 1.2)
        valBox.TextXAlignment = Enum.TextXAlignment.Right
        valBox.ClearTextOnFocus = false
        valBox.Parent = container

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 4)
        track.Position = UDim2.new(0, 12, 1, -14)
        track.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        track.BackgroundTransparency = 0.3
        track.Parent = container

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track

        local fill = Instance.new("Frame")
        local startPct = math.clamp((default - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(startPct, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(120, 140, 255)
        fill.Parent = track

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = fill

        local dragging = false
        local currentValue = default

        local function update(pct, val, silent)
            local clampedPct = math.clamp(pct, 0, 1)
            local value = val or math.floor(min + (max - min) * clampedPct)
            value = math.clamp(value, min, max)
            currentValue = value
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            valBox.Text = tostring(value)
            if not silent and callback then callback(value) end
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                local pct = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                update(pct)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pct = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                update(pct)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        valBox.FocusLost:Connect(function()
            local num = tonumber(valBox.Text)
            if num then
                num = math.clamp(num, min, max)
                local pct = (num - min) / (max - min)
                update(pct, num)
            else
                valBox.Text = tostring(currentValue)
            end
        end)

        local obj = {
            key = name,
            setValue = function(v, silent)
                local pct = (v - min) / (max - min)
                update(pct, v, silent)
            end,
            getValue = function() return currentValue end,
            min = min, max = max,
            forceCallback = function(v)
                if callback then callback(v) end
            end
        }
        table.insert(window.Registry.sliders, obj)
    end)
end

--[[
    CreateDropdown({
