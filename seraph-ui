        valBox.Position = UDim2.new(0.7, -12, 0, 6)
        valBox.BackgroundTransparency = 1
        valBox.Font = Enum.Font.Ubuntu
        valBox.Text = tostring(default)
        valBox.TextColor3 = Color3.fromRGB(160, 170, 200)
        valBox.TextSize = 12 * math.min(currentScale, 1.2)
        valBox.TextXAlignment = Enum.TextXAlignment.Right
        valBox.ClearTextOnFocus = false
        valBox.Parent = container

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -24, 0, 4)
        track.Position = UDim2.new(0, 12, 1, -14)
        track.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        track.BackgroundTransparency = 0.3
        track.Parent = container

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = track

        local fill = Instance.new("Frame")
        local startPct = math.clamp((default - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(startPct, 0, 1, 0)
        fill.BackgroundColor3 = ACCENT.color
        fill.Parent = track

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = fill

        registerAccent(function() fill.BackgroundColor3 = ACCENT.color end)

        local draggingSlider = false
        local currentValue = default

        local function update(pct, val, silent)
            local cp = math.clamp(pct, 0, 1)
            local value = val or math.floor(min + (max - min) * cp)
            value = math.clamp(value, min, max)
            currentValue = value
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            valBox.Text = tostring(value)
            if not silent and callback then callback(value) end
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = true
                local pct = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                update(pct)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pct = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
                update(pct)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingSlider = false
            end
        end)

        valBox.FocusLost:Connect(function()
            local num = tonumber(valBox.Text)
            if num then
                num = math.clamp(num, min, max)
                local pct = (num - min) / (max - min)
                update(pct, num)
            else
                valBox.Text = tostring(currentValue)
            end
        end)

        local obj = {
            key = key,
            setValue = function(v, silent)
                local pct = (v - min) / (max - min)
                update(pct, v, silent)
            end,
            getValue = function() return currentValue end,
            min = min,
            max = max,
            forceCallback = function(v) if callback then callback(v) end end
        }
        table.insert(registry.sliders, obj)
        return obj
    end

