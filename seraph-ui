local function shortenKeyName(key)
    if not key then return "None" end
    local name = key.Name
    local replacements = {
        ["RightShift"] = "RShift", ["LeftShift"] = "LShift",
        ["RightControl"] = "RCtrl", ["LeftControl"] = "LCtrl",
        ["RightAlt"] = "RAlt", ["LeftAlt"] = "LAlt",
        ["RightCommand"] = "RCmd", ["LeftCommand"] = "LCmd",
        ["Escape"] = "Esc", ["Return"] = "Enter", ["Backspace"] = "BkSpc",
        ["CapsLock"] = "Caps", ["Insert"] = "Ins", ["Delete"] = "Del",
        ["PageUp"] = "PgUp", ["PageDown"] = "PgDn",
        ["PrintScreen"] = "PrtSc", ["ScrollLock"] = "ScrLk", ["NumLock"] = "NumLk",
        ["LeftBracket"] = "[", ["RightBracket"] = "]",
        ["Semicolon"] = ";", ["Quote"] = "'", ["Comma"] = ",",
        ["Period"] = ".", ["Slash"] = "/", ["Backslash"] = "\\",
        ["Tilde"] = "~", ["Equals"] = "=", ["Minus"] = "-",
        ["Zero"] = "0", ["One"] = "1", ["Two"] = "2", ["Three"] = "3",
        ["Four"] = "4", ["Five"] = "5", ["Six"] = "6", ["Seven"] = "7",
        ["Eight"] = "8", ["Nine"] = "9"
    }
    return replacements[name] or name
end

local function keyCodeToName(keyCode)
    if not keyCode then return nil end
    return keyCode.Name
end

local function nameToKeyCode(name)
    if not name then return nil end
    local ok, result = pcall(function() return Enum.KeyCode[name] end)
    if ok then return result end
    return nil
end

-- ============================================================
-- INTRO ANIMATION
-- ============================================================

local function playIntro(options, onComplete)
    local introGui = Instance.new("ScreenGui")
    introGui.Name = "SeraphIntroGui"
    introGui.IgnoreGuiInset = true
    introGui.Parent = CoreGui

    local blur = Instance.new("BlurEffect")
    blur.Size = 0
    blur.Parent = Lighting

    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Brightness = 0
    colorCorrection.Contrast = 0
    colorCorrection.Parent = Lighting

    local introMainFrame = Instance.new("Frame")
    introMainFrame.Size = UDim2.new(1, 0, 1, 0)
    introMainFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
    introMainFrame.BackgroundTransparency = 1
    introMainFrame.BorderSizePixel = 0
    introMainFrame.Parent = introGui

    local introLogo = Instance.new("ImageLabel")
    introLogo.AnchorPoint = Vector2.new(0.5, 0.5)
    introLogo.Position = UDim2.new(0.5, 0, 0.5, 0)
    introLogo.Size = UDim2.new(0, 100, 0, 100)
    introLogo.BackgroundTransparency = 1
    introLogo.Image = options.IntroLogo or options.Logo or "rbxassetid://93199758328458"
    introLogo.ImageTransparency = 1
    introLogo.Rotation = -45
    introLogo.Parent = introMainFrame

    local sound
    if options.WithSound and options.IntroSound then
        sound = Instance.new("Sound")
        sound.SoundId = options.IntroSound
        sound.Volume = 0.6
        sound.Parent = introGui
        pcall(function() ContentProvider:PreloadAsync({sound}) end)
        sound:Play()
    end

    TweenService:Create(blur, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = 28}):Play()
    TweenService:Create(introMainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0.3}):Play()
    TweenService:Create(colorCorrection, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Brightness = 0.15, Contrast = 0.2}):Play()

    task.delay(0.3, function()
        TweenService:Create(colorCorrection, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Brightness = 0, Contrast = 0}):Play()
    end)

    TweenService:Create(introLogo, TweenInfo.new(1.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        ImageTransparency = 0,
        Size = UDim2.new(0, 320, 0, 320),
        Rotation = 0
    }):Play()

    local skipText = Instance.new("TextLabel")
    skipText.Size = UDim2.new(1, 0, 0, 30)
    skipText.Position = UDim2.new(0.5, 0, 1, -50)
    skipText.AnchorPoint = Vector2.new(0.5, 0.5)
    skipText.BackgroundTransparency = 1
    skipText.Font = Enum.Font.Ubuntu
    skipText.Text = "Press ENTER to skip intro..."
    skipText.TextColor3 = Color3.fromRGB(255, 255, 255)
    skipText.TextSize = 19
    skipText.TextTransparency = 1
    skipText.Parent = introMainFrame

    local active = true
    local tickTime = 0
    task.spawn(function()
        while active do
            tickTime = tickTime + task.wait()
            if introLogo and introLogo.Parent and introLogo.Rotation ~= 0 then
                introLogo.Rotation = math.sin(tickTime * 2) * 4
            end
        end
    end)

    task.delay(1, function()
        if skipText and skipText.Parent then
            TweenService:Create(skipText, TweenInfo.new(0.5), {TextTransparency = 0.5}):Play()
        end
    end)

    local finished = false
    local function finishIntro()
        if finished then return end
        finished = true
        active = false
        if skipText then skipText:Destroy() end

        local outInfo = TweenInfo.new(0.8, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
        TweenService:Create(blur, outInfo, {Size = 0}):Play()
        TweenService:Create(introMainFrame, outInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(introLogo, outInfo, {
            ImageTransparency = 1,
            Size = UDim2.new(0, 400, 0, 400),
            Rotation = 45
        }):Play()

        task.wait(0.8)
        introGui:Destroy()
        blur:Destroy()
        colorCorrection:Destroy()
        if onComplete then onComplete() end
    end

    local skipConn
    skipConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Return then
            skipConn:Disconnect()
            finishIntro()
        end
    end)

    task.delay(3.5, function()
        if not finished then
            skipConn:Disconnect()
            finishIntro()
        end
    end)
end

-- ============================================================
-- TAB CLASS (declared early so CreateTab can return real Tab objects)
-- ============================================================

local Tab = {}
Tab.__index = Tab

function Tab.new(window, name, icon)
    local self = setmetatable({}, Tab)
    self.Window = window
    self.Name = name
    self.Icon = icon or "rbxassetid://135608228388978"
    self.Page = nil           -- set when UI is built
    self.WidgetQueue = {}     -- queued widget builders to run once Page exists
    self.IsBuilt = false
    return self
end

-- Internal: actually run a widget builder function
-- If the page exists, run immediately; otherwise queue it.
function Tab:_enqueue(fn)
    if self.IsBuilt and self.Page then
        fn(self.Page)
    else
        table.insert(self.WidgetQueue, fn)
    end
end

-- Called by Window after UI is built
function Tab:_flushQueue(page)
    self.Page = page
    self.IsBuilt = true
    for _, fn in ipairs(self.WidgetQueue) do
        fn(page)
    end
    self.WidgetQueue = {}
end

-- ============================================================
-- WINDOW CLASS
-- ============================================================

local Window = {}
Window.__index = Window

function Window.new(options)
    local self = setmetatable({}, Window)
    self.Options = options or {}
    self.ScreenGui = nil
    self.Main = nil
    self.Title = nil
    self.Tabs = {}          -- map: tabName -> {btn, stroke, icon, label, page}
    self.TabObjects = {}    -- map: tabName -> Tab object
    self.TabOrder = {}      -- ordered list of tab names
    self.Pages = {}         -- map: tabName -> ScrollingFrame
    self.Registry = {
        toggles = {},
        sliders = {},
        dropdowns = {},
        keybinds = {}
    }
    self.BaseWidth = self.Options.Width or 620
    self.BaseHeight = self.Options.Height or 380
    self.CurrentScale = 1
    self.ToggleUIKey = Enum.KeyCode.RightShift
    self.UIHidden = false
    self.ActiveTab = nil

    -- Config system
    self.ConfigFolder = self.Options.ConfigFolder or "SeraphConfigs"
    self.ConfigIndexFile = self.ConfigFolder .. "/index.json"
    self.SavedConfigs = {}
    self.DefaultConfig = nil
    self.SelectedConfig = nil
    self.HasFileSystem = (typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function")

    if self.HasFileSystem then
        pcall(function()
            if not isfolder(self.ConfigFolder) then
                makefolder(self.ConfigFolder)
            end
        end)
    end

    self:_loadIndex()
    return self
end

function Window:_loadIndex()
    if not self.HasFileSystem then return end
    if not isfile(self.ConfigIndexFile) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(self.ConfigIndexFile))
        if data.configs then self.SavedConfigs = data.configs end
        if data.default then self.DefaultConfig = data.default end
    end)
end

function Window:_saveIndex()
    if not self.HasFileSystem then return end
    pcall(function()
        writefile(self.ConfigIndexFile, HttpService:JSONEncode({
            configs = self.SavedConfigs,
            default = self.DefaultConfig
        }))
    end)
end

function Window:_getConfigPath(name)
    return self.ConfigFolder .. "/" .. name .. ".json"
end

function Window:_saveConfigFile(name, data)
    if not self.HasFileSystem then return end
    pcall(function()
        writefile(self:_getConfigPath(name), HttpService:JSONEncode(data))
    end)
end

function Window:_loadConfigFile(name)
    if not self.HasFileSystem then return nil end
    local path = self:_getConfigPath(name)
    if not isfile(path) then return nil end
    local ok, result = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok then return result end
    return nil
end

function Window:_deleteConfigFile(name)
    if not self.HasFileSystem then return end
    pcall(function()
        if isfile(self:_getConfigPath(name)) then
            delfile(self:_getConfigPath(name))
        end
    end)
end

function Window:Build()
    if self.ScreenGui then return end
    if self.Options.WithIntro then
        playIntro(self.Options, function()
            self:_createUI()
        end)
    else
        self:_createUI()
    end
end

-- ============================================================
-- WINDOW: CREATE TAB
-- ============================================================

function Window:CreateTab(name, icon)
    if self.TabObjects[name] then
        return self.TabObjects[name]
    end
    local tab = Tab.new(self, name, icon)
    self.TabObjects[name] = tab
    table.insert(self.TabOrder, name)
    return tab
end

function Window:ActivateTab(name)
    if self.ActiveTab == name then return end
    self.ActiveTab = name

    for tabName, data in pairs(self.Tabs) do
        if tabName == name then
            TweenService:Create(data.btn, TweenInfo.new(0.25), {BackgroundTransparency = 0.85}):Play()
            TweenService:Create(data.stroke, TweenInfo.new(0.25), {Transparency = 0.8}):Play()
            TweenService:Create(data.icon, TweenInfo.new(0.25), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(data.label, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            data.page.Visible = true
            data.page.CanvasPosition = Vector2.new(0, 0)
        else
            TweenService:Create(data.btn, TweenInfo.new(0.25), {BackgroundTransparency = 0.95}):Play()
            TweenService:Create(data.stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
            TweenService:Create(data.icon, TweenInfo.new(0.25), {ImageColor3 = Color3.fromRGB(180, 180, 200)}):Play()
            TweenService:Create(data.label, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(180, 180, 200)}):Play()
            data.page.Visible = false
        end
    end
end

