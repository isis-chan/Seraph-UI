            if activeTab == name then
                ts.Color = ACCENT.color
                iconLbl.ImageColor3 = ACCENT.color
                label.TextColor3 = ACCENT.color
            end
        end)

        if next(tabs) == tabObj then
            tabObj:SetActive()
        end

        if name == "Configs" then
            task.defer(function() buildConfigUI(page) end)
        end

        return tabObj
    end

    local function finalizeIntro()
        Main.Visible = true
        local w = baseWidth * currentScale
        local h = baseHeight * currentScale
        TweenService:Create(Main, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, w, 0, h),
            Position = UDim2.new(0.5, -w/2, 0.5, -h/2),
            BackgroundTransparency = 0.25
        }):Play()
        TweenService:Create(MainStroke, TweenInfo.new(0.5), {Transparency = 0.85}):Play()
    end

    if WithIntro then
        local introGui = Instance.new("ScreenGui")
        introGui.Name = "EpicIntroGui"
        introGui.IgnoreGuiInset = true
        introGui.DisplayOrder = 200
        introGui.Parent = CoreGui

        local blur = Instance.new("BlurEffect")
        blur.Size = 0
        blur.Parent = Lighting

        local cc = Instance.new("ColorCorrectionEffect")
        cc.Brightness = 0
        cc.Contrast = 0
        cc.Parent = Lighting

        local introFrame = Instance.new("Frame")
        introFrame.Size = UDim2.new(1, 0, 1, 0)
        introFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 5)
        introFrame.BackgroundTransparency = 1
        introFrame.BorderSizePixel = 0
        introFrame.Parent = introGui

        local introLogo = Instance.new("ImageLabel")
        introLogo.AnchorPoint = Vector2.new(0.5, 0.5)
        introLogo.Position = UDim2.new(0.5, 0, 0.5, 0)
        introLogo.Size = UDim2.new(0, 100, 0, 100)
        introLogo.BackgroundTransparency = 1
        introLogo.Image = IntroLogoAsset
        introLogo.ImageTransparency = 1
        introLogo.Rotation = -45
        introLogo.Parent = introFrame

        local introSound
        if WithSound then
            introSound = Instance.new("Sound")
            introSound.SoundId = IntroSoundId
            introSound.Volume = 0.6
            introSound.Parent = introGui
            ContentProvider:PreloadAsync({introSound})
            introSound:Play()
        end

        TweenService:Create(blur, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = 28}):Play()
        TweenService:Create(introFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0.3}):Play()
        TweenService:Create(cc, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Brightness = 0.15, Contrast = 0.2}):Play()
        task.delay(0.3, function()
            TweenService:Create(cc, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Brightness = 0, Contrast = 0}):Play()
        end)
        TweenService:Create(introLogo, TweenInfo.new(1.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            ImageTransparency = 0,
            Size = UDim2.new(0, 320, 0, 320),
            Rotation = 0
        }):Play()

        local skipText = Instance.new("TextLabel")
        skipText.Size = UDim2.new(1, 0, 0, 30)
        skipText.Position = UDim2.new(0.5, 0, 1, -50)
        skipText.AnchorPoint = Vector2.new(0.5, 0.5)
        skipText.BackgroundTransparency = 1
        skipText.Font = Enum.Font.Ubuntu
        skipText.Text = "Press ENTER to skip intro..."
        skipText.TextColor3 = Color3.fromRGB(255, 255, 255)
        skipText.TextSize = 19
        skipText.TextTransparency = 1
        skipText.Parent = introFrame
        task.delay(1, function()
            if skipText and skipText.Parent then
                TweenService:Create(skipText, TweenInfo.new(0.5), {TextTransparency = 0.5}):Play()
            end
        end)

        local active = true
        local tickTime = 0
        task.spawn(function()
            while active do
                tickTime = tickTime + task.wait()
                if introLogo and introLogo.Parent and introLogo.Rotation ~= 0 then
                    introLogo.Rotation = math.sin(tickTime * 2) * 4
                end
            end
        end)

        local skipIntro = false
        local skipConn
        skipConn = UserInputService.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Return then
                if not skipIntro and introGui and introGui.Parent then
                    skipIntro = true
                    skipConn:Disconnect()
                    if skipText then skipText:Destroy() end
                    active = false
                    local oi = TweenInfo.new(0.8, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
                    TweenService:Create(blur, oi, {Size = 0}):Play()
                    TweenService:Create(introFrame, oi, {BackgroundTransparency = 1}):Play()
                    TweenService:Create(introLogo, oi, {
                        ImageTransparency = 1, Size = UDim2.new(0, 400, 0, 400), Rotation = 45
                    }):Play()
                    task.wait(0.2)
                    introGui:Destroy()
                    blur:Destroy()
                    cc:Destroy()
                    finalizeIntro()
                end
            end
        end)

        task.spawn(function()
            task.wait(3.5)
            if not skipIntro then
                active = false
                if skipConn then skipConn:Disconnect() end
                if skipText then skipText:Destroy() end
                local oi = TweenInfo.new(0.8, Enum.EasingStyle.Exponential, Enum.EasingDirection.In)
                TweenService:Create(blur, oi, {Size = 0}):Play()
                TweenService:Create(introFrame, oi, {BackgroundTransparency = 1}):Play()
                TweenService:Create(introLogo, oi, {
                    ImageTransparency = 1, Size = UDim2.new(0, 400, 0, 400), Rotation = 45
                }):Play()
                task.wait(0.8)
                introGui:Destroy()
                blur:Destroy()
                cc:Destroy()
                finalizeIntro()
            end
        end)
    else
        finalizeIntro()
    end

    return Window
end

return Seraph
