                local ratio = baseHeight / baseWidth
                if resizingCorner == "BottomRight" then
                    nW = math.max(ms, resizeStartSize.X.Offset + delta.X)
                    nH = math.max(ms * ratio, resizeStartSize.Y.Offset + delta.Y)
                elseif resizingCorner == "BottomLeft" then
                    nW = math.max(ms, resizeStartSize.X.Offset - delta.X)
                    nH = math.max(ms * ratio, resizeStartSize.Y.Offset + delta.Y)
                    nX = resizeStartPos.X.Offset + (resizeStartSize.X.Offset - nW)
                elseif resizingCorner == "TopRight" then
                    nW = math.max(ms, resizeStartSize.X.Offset + delta.X)
                    nH = math.max(ms * ratio, resizeStartSize.Y.Offset - delta.Y)
                    nY = resizeStartPos.Y.Offset + (resizeStartSize.Y.Offset - nH)
                elseif resizingCorner == "TopLeft" then
                    nW = math.max(ms, resizeStartSize.X.Offset - delta.X)
                    nH = math.max(ms * ratio, resizeStartSize.Y.Offset - delta.Y)
                    nX = resizeStartPos.X.Offset + (resizeStartSize.X.Offset - nW)
                    nY = resizeStartPos.Y.Offset + (resizeStartSize.Y.Offset - nH)
                end
                Main.Size = UDim2.new(0, nW, 0, nH)
                Main.Position = UDim2.new(resizeStartPos.X.Scale, nX, resizeStartPos.Y.Scale, nY)
