function Window:SerializeState()
    local data = { toggles = {}, sliders = {}, dropdowns = {}, keybinds = {} }
    for _, t in ipairs(self.Registry.toggles) do
        data.toggles[t.key] = { state = t.getState(), bind = keyCodeToName(t.getBind()) }
    end
    for _, s in ipairs(self.Registry.sliders) do
        data.sliders[s.key] = s.getValue()
    end
    for _, d in ipairs(self.Registry.dropdowns) do
        data.dropdowns[d.key] = d.getSelected()
    end
    for _, k in ipairs(self.Registry.keybinds) do
        data.keybinds[k.key] = keyCodeToName(k.getKey())
    end
    return data
end

function Window:ApplyState(data, silent)
    if not data then return end
    if data.toggles then
        for _, t in ipairs(self.Registry.toggles) do
            local entry = data.toggles[t.key]
            if entry then
                if entry.state ~= nil then t.setState(entry.state, silent) end
                if entry.bind ~= nil then t.setBind(nameToKeyCode(entry.bind)) end
            end
        end
    end
    if data.sliders then
        for _, s in ipairs(self.Registry.sliders) do
            local v = data.sliders[s.key]
            if v ~= nil then
                s.setValue(v, silent)
                if s.key == "UI Scale" then s.forceCallback(v) end
            end
        end
    end
    if data.dropdowns then
        for _, d in ipairs(self.Registry.dropdowns) do
            local v = data.dropdowns[d.key]
            if v ~= nil then d.setSelected(v, silent) end
        end
    end
    if data.keybinds then
        for _, k in ipairs(self.Registry.keybinds) do
            local v = data.keybinds[k.key]
            if v ~= nil then
                k.setKey(nameToKeyCode(v), silent)
                if k.key == "Toggle UI Key" then
                    self.ToggleUIKey = nameToKeyCode(v) or Enum.KeyCode.RightShift
                end
            end
        end
    end
end

function Window:GetSavedConfigs() return self.SavedConfigs end
function Window:GetDefaultConfig() return self.DefaultConfig end
function Window:GetSelectedConfig() return self.SelectedConfig end
function Window:SetSelectedConfig(name) self.SelectedConfig = name end

function Window:SaveConfig(name)
    if not name or name == "" then return end
    local exists = false
    for _, existing in ipairs(self.SavedConfigs) do
        if existing == name then exists = true break end
    end
    if not exists then table.insert(self.SavedConfigs, name) end
    self.SelectedConfig = name
    self:_saveConfigFile(name, self:SerializeState())
    self:_saveIndex()
    self:_refreshConfigList()
end

function Window:LoadConfig(name)
    local data = self:_loadConfigFile(name)
    if data then self:ApplyState(data, false) end
end

function Window:RenameConfig(oldName, newName)
    if not oldName or not newName or newName == "" or newName == oldName then return end
    for _, existing in ipairs(self.SavedConfigs) do
        if existing == newName then return end
    end
    local data = self:_loadConfigFile(oldName)
    self:_deleteConfigFile(oldName)
    for i, n in ipairs(self.SavedConfigs) do
        if n == oldName then self.SavedConfigs[i] = newName break end
    end
    if self.DefaultConfig == oldName then self.DefaultConfig = newName end
    if data then self:_saveConfigFile(newName, data) end
    self.SelectedConfig = newName
    self:_saveIndex()
    self:_refreshConfigList()
end

function Window:DeleteConfig(name)
    if not name then return end
    self:_deleteConfigFile(name)
    for i, n in ipairs(self.SavedConfigs) do
        if n == name then table.remove(self.SavedConfigs, i) break end
    end
    if self.DefaultConfig == name then self.DefaultConfig = nil end
    if self.SelectedConfig == name then self.SelectedConfig = nil end
    self:_saveIndex()
    self:_refreshConfigList()
end

function Window:SetDefaultConfig(name)
    if not name then return end
    self.DefaultConfig = name
    self:_saveIndex()
    self:_refreshConfigList()
end

function Window:OverwriteConfig(name)
    if not name then return end
    self:_saveConfigFile(name, self:SerializeState())
end

