    local function applyTextScale()
        local ts = math.min(currentScale, 1.2)
        TitleLabel.TextSize = 16 * ts
        for _, td in pairs(tabs) do td.label.TextSize = 13 * ts end
        for _, page in pairs(pages) do
            for _, child in ipairs(page:GetChildren()) do
                if child:IsA("Frame") then
                    for _, sub in ipairs(child:GetChildren()) do
                        if sub:IsA("TextLabel") then sub.TextSize = 14 * ts end
                        if sub:IsA("TextBox") then sub.TextSize = 13 * ts end
                        if sub:IsA("TextButton") then
                            local il = sub:FindFirstChildWhichIsA("TextLabel")
                            if il then il.TextSize = 13 * ts end
                            if sub.Parent and sub.Parent.Name == "DropdownContainer" then
                                sub.TextSize = 13 * ts
                            end
                        end
                    end
                end
            end
        end
    end

    local function applyScaleFull()
        local w = baseWidth * currentScale
        local h = baseHeight * currentScale
        if not uiHidden then
            local centerX = Main.Position.X.Offset + Main.Size.X.Offset / 2
            local centerY = Main.Position.Y.Offset + Main.Size.Y.Offset / 2
            Main.Size = UDim2.new(0, w, 0, h)
            Main.Position = UDim2.new(Main.Position.X.Scale, centerX - w/2, Main.Position.Y.Scale, centerY - h/2)
        end
        applyTextScale()
    end

