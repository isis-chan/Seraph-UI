            bindKeyLabel.TextSize = 11
            bindKeyLabel.TextXAlignment = Enum.TextXAlignment.Center
            bindKeyLabel.Parent = bindKeyBtn

            boundKey = defaultBind
        end

        local state = default

        local function setState(newState, silent)
            state = newState
            local targetPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            local targetColor = state and Color3.fromRGB(100, 120, 255) or Color3.fromRGB(40, 40, 50)
            local targetTrans = state and 0.2 or 0.5

            TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Position = targetPos}):Play()
            TweenService:Create(switch, TweenInfo.new(0.25), {BackgroundColor3 = targetColor, BackgroundTransparency = targetTrans}):Play()

            if not silent and callback then callback(state) end
        end

        local switchButton = Instance.new("TextButton")
        switchButton.Size = UDim2.new(1, 0, 1, 0)
        switchButton.BackgroundTransparency = 1
        switchButton.Text = ""
        switchButton.Parent = switch

        switchButton.MouseButton1Click:Connect(function()
            setState(not state)
        end)

        if hasBind and bindKeyBtn then
            bindKeyBtn.MouseButton1Click:Connect(function()
                if bindListening then return end
                bindListening = true
                bindKeyLabel.Text = "..."
                bindKeyLabel.TextColor3 = Color3.fromRGB(255, 255, 100)

                local connection
                connection = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        if input.KeyCode == Enum.KeyCode.Escape then
                            boundKey = nil
                            bindKeyLabel.Text = "None"
                        else
                            boundKey = input.KeyCode
