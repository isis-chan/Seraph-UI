    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and Main then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Build configs page (only if a "Configs" tab exists)
    if self.TabObjects["Configs"] then
        self:_buildConfigsPage()
    end

    -- Auto-load default config
    if self.DefaultConfig then
        local data = self:_loadConfigFile(self.DefaultConfig)
        if data then
            task.delay(0.6, function()
                self:ApplyState(data, false)
            end)
        end
    end
end

