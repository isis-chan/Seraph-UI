    local lastKbHash = ""
    local function refreshKeybindList()
        if not kbList or not kbList.Parent then return end
        local entries = {}
        for _, t in ipairs(registry.toggles) do
            local b = t.getBind()
            if b then
                table.insert(entries, {name = t.key, keyName = shortenKeyName(b), isToggle = true, state = t.getState()})
            end
        end
        for _, k in ipairs(registry.keybinds) do
            if k.key ~= "Toggle UI Key" then
                local key = k.getKey()
                if key then
                    table.insert(entries, {name = k.key, keyName = shortenKeyName(key), isToggle = false, state = false})
                end
            end
        end
        local hp = {}
        for i, e in ipairs(entries) do hp[i] = e.name .. ":" .. e.keyName .. ":" .. tostring(e.state) end
        local hash = table.concat(hp, "|") .. "#" .. tostring(ACCENT.color.R) .. "," .. tostring(ACCENT.color.G) .. "," .. tostring(ACCENT.color.B)
        if hash == lastKbHash then return end
        lastKbHash = hash
        for _, ch in ipairs(kbList:GetChildren()) do
            if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
        end
        local rh = 20
        local pad = 3
        if #entries == 0 then
            local el = Instance.new("TextLabel")
            el.Size = UDim2.new(1, 0, 0, rh)
            el.BackgroundTransparency = 1
            el.Font = Enum.Font.Ubuntu
            el.Text = "No keybinds"
            el.TextColor3 = Color3.fromRGB(120, 120, 140)
            el.TextSize = 12
            el.TextXAlignment = Enum.TextXAlignment.Left
            el.ZIndex = 52
            el.LayoutOrder = 1
            el.Parent = kbList
            kbList.Size = UDim2.new(1, -12, 0, rh)
            KeybindListGui.Size = UDim2.new(0, 200, 0, 30 + rh + 8)
        else
            for i, e in ipairs(entries) do
                local row = Instance.new("Frame")
                row.Name = "Row_" .. i
                row.Size = UDim2.new(1, 0, 0, rh)
                row.BackgroundTransparency = 1
                row.LayoutOrder = i
