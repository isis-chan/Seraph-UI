            if typeof(c) ~= "Color3" then c = Color3.fromRGB(255, 255, 255) end
            local r0, g0, b0 = c.R, c.G, c.B
            local maxC = math.max(r0, g0, b0)
            local minC = math.min(r0, g0, b0)
            local delta = maxC - minC
            v = maxC
            if delta == 0 then
                h, s = 0, 0
            else
                s = delta / maxC
                if maxC == r0 then h = ((g0 - b0) / delta) % 6
                elseif maxC == g0 then h = (b0 - r0) / delta + 2
                else h = (r0 - g0) / delta + 4 end
                h = h / 6
                if h < 0 then h = h + 1 end
