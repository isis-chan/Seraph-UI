        local w = self.BaseWidth * scale
        local h = self.BaseHeight * scale
        self.Main.Size = UDim2.new(0, w, 0, h)
        self.Main.Position = UDim2.new(0.5, -w/2, 0.5, -h/2)
        self.Main.BackgroundTransparency = 0.25
