        selectBtn.TextSize = 13 * math.min(window.CurrentScale, 1.2)
        selectBtn.TextTruncate = Enum.TextTruncate.AtEnd
        selectBtn.Parent = container

        local selectCorner = Instance.new("UICorner")
        selectCorner.CornerRadius = UDim.new(0, 6)
        selectCorner.Parent = selectBtn

        local listHolder = Instance.new("Frame")
        listHolder.Size = UDim2.new(1, -24, 0, 0)
        listHolder.Position = UDim2.new(0, 12, 0, baseHeight + 8)
        listHolder.BackgroundTransparency = 1
        listHolder.Visible = false
        listHolder.Parent = container

        local listLayout = Instance.new("UIListLayout")
        listLayout.SortOrder = Enum.SortOrder.LayoutOrder
        listLayout.Padding = UDim.new(0, 6)
        listLayout.Parent = listHolder

        local listPadding = Instance.new("UIPadding")
        listPadding.PaddingBottom = UDim.new(0, 12)
        listPadding.Parent = listHolder

        local selected = {}
        if isMulti then
            if type(default) == "table" then
                for _, v in ipairs(default) do selected[v] = true end
            end
        else
            selected[default or options[1]] = true
        end

        local dotMap = {}

        local function updateDisplay(silent)
            if isMulti then
                local list = {}
                for _, opt in ipairs(options) do
                    if selected[opt] then table.insert(list, opt) end
                end
                selectBtn.Text = #list > 0 and table.concat(list, ", ") or "None"
            else
                local found = false
                for opt, val in pairs(selected) do
                    if val then selectBtn.Text = opt found = true break end
                end
                if not found then selectBtn.Text = "None" end
            end
            if not silent and callback then callback(selected) end
        end
        updateDisplay(true)

        for _, opt in ipairs(options) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, optionHeight)
            optBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            optBtn.BackgroundTransparency = 0.96
            optBtn.Font = Enum.Font.Ubuntu
            optBtn.Text = opt
            optBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
            optBtn.TextSize = 13 * math.min(window.CurrentScale, 1.2)
            optBtn.TextXAlignment = Enum.TextXAlignment.Center
            optBtn.Parent = listHolder

            local optCorner = Instance.new("UICorner")
            optCorner.CornerRadius = UDim.new(0, 6)
            optCorner.Parent = optBtn

            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0, 8, 0, 8)
            dot.Position = UDim2.new(1, -16, 0.5, -4)
            dot.BackgroundColor3 = Color3.fromRGB(100, 120, 255)
            dot.BackgroundTransparency = selected[opt] and 0.1 or 1
            dot.Parent = optBtn

            local dotCorner = Instance.new("UICorner")
            dotCorner.CornerRadius = UDim.new(1, 0)
            dotCorner.Parent = dot

            dotMap[opt] = dot

            optBtn.MouseButton1Click:Connect(function()
                if isMulti then
                    selected[opt] = not selected[opt]
                    dot.BackgroundTransparency = selected[opt] and 0.1 or 1
                else
                    for k in pairs(selected) do selected[k] = nil end
                    selected[opt] = true
                    for _, d in pairs(dotMap) do d.BackgroundTransparency = 1 end
                    dot.BackgroundTransparency = 0.1
                    expanded = false
                    TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, -6, 0, baseHeight)}):Play()
                    task.delay(0.25, function() if not expanded then listHolder.Visible = false end end)
                end
                updateDisplay()
            end)
        end

        local function toggleDropdown()
            expanded = not expanded
            if expanded then
                listHolder.Visible = true
                local targetHeight = baseHeight + (#options * (optionHeight + 6)) + 20
                TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, -6, 0, targetHeight)}):Play()
            else
                local tween = TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, -6, 0, baseHeight)})
                tween:Play()
                tween.Completed:Wait()
                if not expanded then listHolder.Visible = false end
            end
        end

        selectBtn.MouseButton1Click:Connect(toggleDropdown)

        local obj = {
            key = name,
            isMulti = isMulti,
            options = options,
            setSelected = function(data, silent)
                for k in pairs(selected) do selected[k] = nil end
                if isMulti then
                    if type(data) == "table" then
                        for _, v in ipairs(data) do
                            if selected[v] == nil then selected[v] = true end
                        end
                    end
                else
                    if data and dotMap[data] then selected[data] = true end
                end
                for opt, dot in pairs(dotMap) do
                    dot.BackgroundTransparency = selected[opt] and 0.1 or 1
                end
                updateDisplay(silent)
            end,
            getSelected = function()
                local list = {}
                for _, opt in ipairs(options) do
                    if selected[opt] then table.insert(list, opt) end
                end
                if isMulti then return list else return list[1] end
            end
        }
        table.insert(window.Registry.dropdowns, obj)
    end)
end

