    local function serializeState()
        local data = { toggles = {}, sliders = {}, dropdowns = {}, keybinds = {}, colorpickers = {} }
        for _, t in ipairs(registry.toggles) do data.toggles[t.key] = {state = t.getState(), bind = keyCodeToName(t.getBind())} end
        for _, s in ipairs(registry.sliders) do data.sliders[s.key] = s.getValue() end
        for _, d in ipairs(registry.dropdowns) do data.dropdowns[d.key] = d.getSelected() end
        for _, k in ipairs(registry.keybinds) do data.keybinds[k.key] = keyCodeToName(k.getKey()) end
        for _, cp in ipairs(registry.colorpickers) do data.colorpickers[cp.key] = cp.getColorTable() end
        data.uiSize = {width = Main.Size.X.Offset, height = Main.Size.Y.Offset}
        return data
    end

    local function applyState(data, silent)
        if not data then return end
        if data.toggles then
            for _, t in ipairs(registry.toggles) do
                local e = data.toggles[t.key]
                if e then
                    if e.state ~= nil then t.setState(e.state, silent) end
                    if e.bind ~= nil then t.setBind(nameToKeyCode(e.bind)) end
                end
            end
        end
        if data.sliders then
            for _, s in ipairs(registry.sliders) do
                local v = data.sliders[s.key]
                if v ~= nil then s.setValue(v, silent) end
            end
        end
        if data.dropdowns then
            for _, d in ipairs(registry.dropdowns) do
                local v = data.dropdowns[d.key]
                if v ~= nil then d.setSelected(v, silent) end
            end
        end
        if data.keybinds then
            for _, k in ipairs(registry.keybinds) do
                local v = data.keybinds[k.key]
                if v ~= nil then
                    k.setKey(nameToKeyCode(v), silent)
                    if k.key == "Toggle UI Key" then toggleUIKey = nameToKeyCode(v) or Enum.KeyCode.RightShift end
                end
            end
        end
        if data.colorpickers then
            for _, cp in ipairs(registry.colorpickers) do
                local v = data.colorpickers[cp.key]
                if type(v) == "table" and v.R and v.G and v.B then
                    cp.setColor(v, silent)
                    if cp.key == "Accent Color" then applyAccent(tableToColor(v)) end
                end
            end
        end
        if data.uiSize and data.uiSize.width and data.uiSize.height then
            currentScale = data.uiSize.width / baseWidth
            applyScaleFull()
        end
    end

    local function getConfigPath(name) return CONFIG_FOLDER .. "/" .. name .. ".json" end

    local function saveConfigFile(name, data)
        if not hasFileSystem then return end
        pcall(function()
            local http = game:GetService("HttpService")
            writefile(getConfigPath(name), http:JSONEncode(data))
        end)
    end

    local function loadConfigFile(name)
        if not hasFileSystem then return nil end
        local path = getConfigPath(name)
        if not isfile(path) then return nil end
        local ok, result = pcall(function()
            local http = game:GetService("HttpService")
            return http:JSONDecode(readfile(path))
        end)
        if ok then return result end
        return nil
    end

    local function deleteConfigFile(name)
        if not hasFileSystem then return end
        pcall(function() if isfile(getConfigPath(name)) then delfile(getConfigPath(name)) end end)
    end

    local function saveIndex()
        if not hasFileSystem then return end
        pcall(function()
            local http = game:GetService("HttpService")
            writefile(CONFIG_INDEX_FILE, http:JSONEncode({configs = savedConfigs, default = defaultConfig}))
        end)
    end

    local function loadIndex()
        if not hasFileSystem then return end
        if not isfile(CONFIG_INDEX_FILE) then return end
        pcall(function()
            local http = game:GetService("HttpService")
            local data = http:JSONDecode(readfile(CONFIG_INDEX_FILE))
            if data.configs then savedConfigs = data.configs end
            if data.default then defaultConfig = data.default end
        end)
    end

